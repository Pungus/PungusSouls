using System.Collections.Generic;
using HarmonyLib;
using UnityEngine;
using ItemManager;
using System.Reflection;



namespace PungusSouls
{
    [HarmonyPatch]
    public class Animations
    {
        internal const string ModName = "PungusSouls";
        internal const string Author = "Pungus";
        private const string ModGUID = Author + "." + ModName;
        private static readonly Dictionary<string, string> CoolAnimation = new();
        private static Dictionary<string, AnimationClip> _externalAnimations = new();
        private static bool _firstInit;
        internal static AnimatorOverrideController OverrideController;

        private static readonly Dictionary<string, AnimationClip> OriginalAnimations = new();

        private static void UpdateAnimator(Player player)
        {
            if (player == null || player.m_animator == null)
                return;

            if (OverrideController == null)
                return;

            var overrides = new List<KeyValuePair<AnimationClip, AnimationClip>>();
            OverrideController.GetOverrides(overrides);

            foreach (var pair in overrides)
            {
                Debug.Log($"KEY='{pair.Key.name}' VALUE='{pair.Value?.name}'");
            }
            ItemDrop.ItemData weapon = player.GetCurrentWeapon();

            bool useCustomAnimations =
                weapon != null &&
                weapon.m_shared.m_name == "$ps_abyssgreatsword";
            if (player.m_animator.runtimeAnimatorController == null)
            {
                Debug.LogError("runtimeAnimatorController is null");
                return;
            }

            Debug.Log("Current controller: " + player.m_animator.runtimeAnimatorController.name);

            foreach (var pair in CoolAnimation)
            {
                if (useCustomAnimations)
                {
                    if (!_externalAnimations.TryGetValue(pair.Value, out var custom) || custom == null)
                    {
                        Debug.LogError($"Missing or NULL external animation: {pair.Value}");
                        continue;
                    }

                    OverrideController[pair.Key] = custom;
                }
                else
                {
                    if (!OriginalAnimations.TryGetValue(pair.Key, out var original) || original == null)
                    {
                        Debug.LogError($"Missing or NULL original animation: {pair.Key}");
                        continue;
                    }

                    OverrideController[pair.Key] = original;
                    Debug.Log($"Replacing '{pair.Key}' with '{OverrideController[pair.Key]?.name}'");
                }
            }
        }
        public void Awake()
        {
            AssetBundle asset = PrefabManager.RegisterAssetBundle("souls");

            CoolAnimation.Add("Greatsword BaseAttack (1)", "AbyssGreatswordAttack1");
            CoolAnimation.Add("Greatsword Secondary Attack", "AbyssGreatswordAttack2");

            _externalAnimations.Add("AbyssGreatswordAttack1", asset.LoadAsset<AnimationClip>("AbyssGreatswordAttack1"));
            _externalAnimations.Add("AbyssGreatswordAttack2", asset.LoadAsset<AnimationClip>("AbyssGreatswordAttack2"));

            Assembly assembly = Assembly.GetExecutingAssembly();
            Harmony harmony = new(ModGUID);
            harmony.PatchAll(assembly);
        }
       
        [HarmonyPatch(typeof(Player), nameof(Player.Awake))]
        static class TESTPATCHPLAYERANIMS
        {
            static void Postfix(Player __instance)
            {
                if (__instance != Player.m_localPlayer)
                    return;

                if (__instance.m_animator == null)
                    return;

                if (!_firstInit)
                {
                    if (__instance.m_animator.runtimeAnimatorController == null)
                    {
                        return; // allow retry next frame
                    }

                    _firstInit = true;

                    OverrideController =
                        new AnimatorOverrideController(__instance.m_animator.runtimeAnimatorController);

                    foreach (var clip in OverrideController.animationClips)
                    {
                        if (CoolAnimation.ContainsKey(clip.name))
                            OriginalAnimations[clip.name] = clip;
                    }
                }

                if (_firstInit && OverrideController != null)
                {
                    __instance.m_animator.runtimeAnimatorController = OverrideController;
                    UpdateAnimator(__instance);
                }
            }
        }
        [HarmonyPatch(typeof(Humanoid), nameof(Humanoid.EquipItem))]
        static class EquipItemPatch
        {
            static void Postfix(Humanoid __instance)
            {
                if (__instance is Player player && player == Player.m_localPlayer)
                {
                    if (player.m_animator == null || OverrideController == null)
                        return;

                    UpdateAnimator(player);
                }
            }
        }
        [HarmonyPatch(typeof(Humanoid), nameof(Humanoid.UnequipItem))]
        static class UnequipItemPatch
        {
            static void Postfix(Humanoid __instance)
            {
                if (__instance is Player player && player == Player.m_localPlayer)
                {
                    if (player.m_animator == null || OverrideController == null)
                        return;

                    UpdateAnimator(player);
                }
            }
        }     
    }
}